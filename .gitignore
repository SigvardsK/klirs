# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# Claude Code local state (settings.local.json, scheduled task locks)
/.claude/

# Manually exported screening PDFs (user-generated review artefacts; not source)
/pdfs/

# Red-team harness local state (contains Supabase session tokens + run artefacts)
/scripts/red-team/auth.json
/scripts/red-team/runs/

# Internal Sprint planning + strategy docs (BRAND, pricing, outreach drafts, prospect notes — not for public repo)
/docs/sprint-2/

# Internal Claude orientation file (private wayfinding — not for public repo; AGENTS.md is the public contributor guide)
/CLAUDE.md

# Transient i18n translation artifacts (regenerable via scripts/translate-passages.py)
/src/lib/i18n/messages/lv.draft.json
/src/lib/i18n/messages/lv.draft.review.md

# Internal LV legal firm directory (raw firmas.lv-style scrape used for cold-outreach
# enrichment; not for public repo). Also covers any parsed CSVs / shortlists
# Claude generates from it.
/legal-firms-lv
/legal-firms-lv*
/docs/sprint-2/outreach/legal-firms-lv-*
